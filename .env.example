# CareLoop AI - Environment Variables Reference

# Client Firebase Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=careloop-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careloop-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=careloop-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Server Firebase Admin Configuration (Private)
FIREBASE_PROJECT_ID=careloop-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@careloop-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Gemini API
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Background Cron & Security Secrets
CRON_SECRET=super-secure-cloud-scheduler-cron-secret-32-chars
APP_URL=http://localhost:3000

# Mock Mode (Fallback to local safe in-memory / mock mode when real Firebase credentials are not provided)
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
